# Copy to .env and change the values
PORT=4000
# Front-end origins allowed by CORS, separated by commas.
# On Vercel, include the site URL, for example https://wow-store-front.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# Admin login password for the admin panel
ADMIN_PASSWORD=change-me-now
# Long random string used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string
# Supabase project used as the store database. The secret key stays on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
